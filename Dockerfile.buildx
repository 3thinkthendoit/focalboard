# Multi-stage Dockerfile for Focalboard (Go server + Node webapp)
# Build & push to Alibaba Cloud ACR via GitHub Actions.
# Adapted from the rustfs buildx packaging pattern.

# ---------- Stage 1: build webapp ----------
FROM node:20.11.0 AS webapp-builder
# eslint-plugin-mattermost 在 lockfile 里是 git+ssh 依赖，容器内无法用 ssh 拉取；
# 改为 https 匿名克隆。同时需要 git 二进制。
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
    && git config --global url."https://github.com/".insteadOf "git@github.com:" \
    && git config --global url."https://github.com/".insteadOf "ssh://git@github.com/"
# cypress 是 devDependency，install 时会下载二进制；容器内不需要它运行，跳过下载
ENV CYPRESS_INSTALL_BINARY=0
WORKDIR /webapp
COPY webapp/package.json webapp/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --no-optional --ignore-scripts --no-audit --no-fund; else npm install --no-optional --no-audit --no-fund; fi
COPY webapp/ ./
RUN npm run pack

# ---------- Stage 2: build server ----------
FROM golang:1.21 AS server-builder
ENV CGO_ENABLED=1 \
    GOPROXY=https://proxy.golang.org,direct \
    GOSUMDB=sum.golang.org
WORKDIR /server
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN GOOS=linux go build \
    -tags 'json1 sqlite3' \
    -ldflags '-X "github.com/mattermost/focalboard/server/model.Edition=docker"' \
    -o /out/focalboard-server ./main

# ---------- Stage 3: runtime ----------
FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget jq sqlite3 \
    && rm -rf /var/lib/apt/lists/*

ENV FB_PORT=8000 \
    FB_DB_TYPE=sqlite3 \
    FB_DB_CONFIG="" \
    FB_USE_SSL=false \
    FB_SECURE_COOKIES=false

WORKDIR /opt/focalboard

COPY --from=server-builder /out/focalboard-server /opt/focalboard/bin/focalboard-server
COPY --from=webapp-builder /webapp/pack /opt/focalboard/pack
COPY server-config.json /opt/focalboard/config.json
COPY NOTICE.txt /opt/focalboard/NOTICE.txt
COPY docker-buildx/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
