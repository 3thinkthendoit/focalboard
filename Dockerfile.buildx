# Multi-stage Dockerfile for Focalboard (Go server + Node webapp)
# Build & push to Alibaba Cloud ACR via GitHub Actions.
# Build steps closely follow the project's official Dockerfile.build.

# ---------- Stage 1: build webapp ----------
# Official Dockerfile.build uses node:16.3.0 — keep it to stay compatible with
# the older webapp dependency tree (node 20 fails to build native modules).
FROM node:16.3.0@sha256:ca6daf1543242acb0ca59ff425509eab7defb9452f6ae07c156893db06c7a9a4 AS webapp-builder

WORKDIR /webapp
COPY webapp .

### 'CPPFLAGS="-DPNG_ARM_NEON_OPT=0"' avoids an imagemin/optipng build bug.
### Cypress is only used for e2e tests; skip its binary download in the build.
ENV CYPRESS_INSTALL_BINARY=0
RUN CPPFLAGS="-DPNG_ARM_NEON_OPT=0" npm install --no-optional --no-audit --no-fund \
    && npm run pack

# ---------- Stage 2: build server ----------
# Official Dockerfile.build uses golang:1.18.3 and `make server-linux`.
FROM golang:1.18.3@sha256:b203dc573d81da7b3176264bfa447bd7c10c9347689be40540381838d75eebef AS server-builder

ENV CGO_ENABLED=1 \
    GOPROXY=https://proxy.golang.org,direct \
    GOSUMDB=sum.golang.org

WORKDIR /src
COPY . .
COPY --from=webapp-builder /webapp/pack webapp/pack

ARG TARGETARCH
ENV BUILD_NUMBER=docker
RUN make server-linux arch=${TARGETARCH}

# ---------- Stage 3: runtime ----------
FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget jq sqlite3 \
    && rm -rf /var/lib/apt/lists/*

ENV FB_PORT=8000 \
    FB_DB_TYPE=sqlite3 \
    FB_DB_CONFIG="" \
    FB_USE_SSL=false \
    FB_SECURE_COOKIES=false

WORKDIR /opt/focalboard

COPY --from=server-builder /src/bin/linux/focalboard-server /opt/focalboard/bin/focalboard-server
COPY --from=webapp-builder /webapp/pack /opt/focalboard/pack
COPY server-config.json /opt/focalboard/config.json
COPY NOTICE.txt /opt/focalboard/NOTICE.txt
COPY docker-buildx/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
